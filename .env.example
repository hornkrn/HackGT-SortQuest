# Copy to .env on the computer running FastAPI. Never commit real credentials.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hackgt
# Leave empty: python -m server.run generates a key and saves it in .env.
SORTQUEST_API_KEY=
PORT=8000
# ElevenLabs text to speech for the Results voice (optional; Results stays silent without it).
ELEVENLABS_API_KEY=
